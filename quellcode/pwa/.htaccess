# Servereinstellungen für Apache (bei anderen Servern ignorieren)
AddType application/manifest+json .webmanifest
AddType image/svg+xml .svg
DirectoryIndex index.html

<IfModule mod_headers.c>
  # Sicherheit: kein MIME-Raten, nicht in fremde Seiten einbettbar, keine Referrer an Dritte
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Service Worker und Seite nie lange zwischenspeichern, damit Updates sofort ankommen
  <FilesMatch "^(sw\.js|index\.html|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
